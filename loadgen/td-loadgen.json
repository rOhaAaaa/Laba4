{
  "family": "laba4-loadgen",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::235366377533:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "loadgen",
      "image": "235366377533.dkr.ecr.eu-central-1.amazonaws.com/laba4-loadgen:v1",
      "essential": true,
      "environment": [
        {"name":"TARGET","value":"http://18.199.154.139:8080/heavy?seconds=3&mode=cpu"},
        {"name":"VUS","value":"20"},
        {"name":"DURATION","value":"5m"}
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/laba4-loadgen",
          "awslogs-region": "eu-central-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
